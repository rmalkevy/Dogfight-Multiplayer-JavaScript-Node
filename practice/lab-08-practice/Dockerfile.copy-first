# Погано для кешу: спершу весь код, потім npm ci.
# Будь-яка зміна в .js інвалідує COPY . . і все, що після нього, зокрема npm ci.
#   docker build -f Dockerfile.copy-first -t lab08-copy-first .
FROM node:22-alpine
WORKDIR /app
COPY . .
RUN npm ci --omit=dev && echo "npm ci виконано"
EXPOSE 3008
CMD ["node", "server.js"]
